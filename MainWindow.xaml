<Window x:Class="Glint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glint" Width="800" Height="730"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Replaced at runtime by ApplyTheme() to follow the Windows light/dark setting. -->
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="TintBrush" Color="#8C1B1B20"/>
        <SolidColorBrush x:Key="SelBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SepBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="CaretBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSelBrush" Color="#663B9DFF"/>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick"/>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid x:Name="RowGrid" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="28" Height="28"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14.5"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="{Binding Subtitle}" FontSize="11.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11.5" Margin="14,0,16,0"
                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAnswer}" Value="True">
                    <Setter TargetName="RowGrid" Property="Height" Value="64"/>
                    <Setter TargetName="TitleText" Property="FontSize" Value="23"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle}" Value="">
                    <Setter TargetName="SubText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- The window is larger than the panel so the drop shadow has room; the empty area is click-through. -->
    <Grid x:Name="Root" Margin="60,40,60,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.15">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.RenderTransform>

        <!-- Drop shadow. ShadowHost is clipped to everything *outside* the panel so the shadow never
             darkens the glass itself (which matters when the live backdrop shows through). -->
        <Grid x:Name="ShadowHost">
            <Border CornerRadius="28" Background="#59000000">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="16" Direction="270" Opacity="0.45" Color="Black"/>
                </Border.Effect>
            </Border>
        </Grid>

        <Grid x:Name="Panel" SizeChanged="OnPanelSizeChanged">
            <!-- Blurred snapshot of whatever is behind the panel. In a Canvas so it never affects layout. -->
            <Canvas>
                <Image x:Name="Backdrop" Width="680" Height="600" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="Linear"/>
            </Canvas>
            <Rectangle Fill="{DynamicResource TintBrush}"/>
            <!-- soft light falling across the top of the glass -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel>
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21"
                               Foreground="{DynamicResource SubtleBrush}" Margin="8,1,0,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search apps and files, calculate, convert"
                               FontSize="23" Foreground="{DynamicResource SubtleBrush}" Opacity="0.75"
                               VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,2"/>
                    <TextBox x:Name="Query" Grid.Column="1" FontSize="23" Margin="0,0,20,2"
                             Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource CaretBrush}"
                             SelectionBrush="{DynamicResource TextSelBrush}" TextChanged="OnQueryChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <Rectangle x:Name="Separator" Height="1" Margin="18,0" Fill="{DynamicResource SepBrush}"
                           Visibility="Collapsed"/>

                <!-- Heading for the actions / confirmation list that replaces the results (Tab or →). -->
                <TextBlock x:Name="ActionsHeader" Visibility="Collapsed" Margin="24,13,24,0" FontSize="12.5"
                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource SubtleBrush}"/>

                <ListBox x:Name="ResultsList" Visibility="Collapsed" Margin="8,8,8,4" MaxHeight="470"
                         SelectionChanged="OnSelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ItemContainerStyle="{StaticResource RowStyle}"
                         ItemTemplate="{StaticResource RowTemplate}"/>

                <!-- What the keys do for the selected row. -->
                <TextBlock x:Name="Footer" Visibility="Collapsed" Margin="24,2,24,11" FontSize="11.5"
                           Foreground="{DynamicResource SubtleBrush}" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- bright rim that catches the light, like the edge of a piece of glass -->
            <Border CornerRadius="28" BorderThickness="1.25" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B3FFFFFF" Offset="0"/>
                        <GradientStop Color="#33FFFFFF" Offset="0.3"/>
                        <GradientStop Color="#1FFFFFFF" Offset="0.7"/>
                        <GradientStop Color="#73FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>
    </Grid>
</Window>
