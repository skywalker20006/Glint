<Window x:Class="Glint.TopBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skyline" Height="30" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5">

    <Window.Resources>
        <SolidColorBrush x:Key="BarText" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="BarTint" Color="#661B1B20"/>
        <SolidColorBrush x:Key="BarHover" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="BarLine" Color="#1FFFFFFF"/>

        <!-- A clickable area with the soft rounded hover highlight macOS menu bar items have. -->
        <Style x:Key="BarItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="1,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BarHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource BarText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- material layers: Mica (frosted wallpaper), then the tint, then acrylic's grain -->
        <Rectangle x:Name="MicaLayer" Visibility="Collapsed"/>
        <Rectangle Fill="{DynamicResource BarTint}"/>
        <Rectangle x:Name="NoiseLayer" Visibility="Collapsed"/>
        <!-- hairline along the bottom edge, like the menu bar's edge catching the light -->
        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource BarLine}"/>

        <!-- flashes Claude orange across the whole bar for a few seconds when Claude finishes -->
        <Rectangle x:Name="ReadyFlash" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F08A63" Offset="0"/>
                    <GradientStop Color="#D97757" Offset="0.6"/>
                    <GradientStop Color="#C4623F" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <!-- left: opens the Glint search -->
            <Border x:Name="GlintButton" Style="{StaticResource BarItem}"
                    MouseLeftButtonUp="OnGlintClick" ToolTip="Search with Glint">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13.5"/>
                    <TextBlock Text="Glint" FontWeight="SemiBold" Margin="7,0,0,1"
                               Foreground="{DynamicResource BarText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- now playing on Spotify: album art, song, and a live waveform in the cover's colour -->
            <Border x:Name="NowPlaying" Style="{StaticResource BarItem}" Padding="5,0,10,0" Margin="6,4,1,4"
                    Visibility="Collapsed" MouseLeftButtonUp="OnNowPlayingClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4.5" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="SongText" FontWeight="SemiBold" Margin="8,0,0,1" MaxWidth="230"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource BarText}"/>
                    <TextBlock x:Name="ArtistText" Margin="0,0,0,1" MaxWidth="160" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource BarText}"/>
                    <!-- the waveform: bars grow from the middle, like the Dynamic Island -->
                    <!-- fixed-size canvas: bar changes never trigger a layout pass of the rest of the bar -->
                    <Canvas x:Name="Wave" Margin="11,0,0,0" Width="27.5" Height="16" VerticalAlignment="Center">
                        <Canvas.Effect>
                            <DropShadowEffect x:Name="WaveGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>
                        </Canvas.Effect>
                    </Canvas>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- centre: date and time (opens the Windows calendar / notifications) -->
            <Border Grid.Column="1" Style="{StaticResource BarItem}" MouseLeftButtonUp="OnClockClick">
                <TextBlock x:Name="Clock" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,1"
                           Foreground="{DynamicResource BarText}"/>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- network speed: two small stacked lines, fixed width so the bar doesn't jiggle -->
                <!-- click for data used since the PC started -->
                <Border x:Name="SpeedPanel" Style="{StaticResource BarItem}" Padding="6,0" Margin="1,4,4,4"
                        MouseLeftButtonUp="OnSpeedClick" ToolTip="Network speed. Click for data used since your PC started.">
                <Grid VerticalAlignment="Center" Width="72">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UpText" FontSize="9.5" FontWeight="SemiBold" LineHeight="11"
                               LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BarText}"/>
                    <TextBlock x:Name="DownText" Grid.Row="1" FontSize="9.5" FontWeight="SemiBold" LineHeight="11"
                               LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Right"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BarText}"/>
                </Grid>
                </Border>

                <!-- volume: click for a slider, scroll to adjust -->
                <Border x:Name="VolumeButton" Style="{StaticResource BarItem}"
                        MouseLeftButtonUp="OnVolumeClick" MouseWheel="OnVolumeWheel">
                    <TextBlock x:Name="VolumeIcon" Text="&#xE995;" Style="{StaticResource Icon}" Width="17"/>
                </Border>

                <!-- Bluetooth, Wi-Fi and battery: open Windows Quick Settings -->
                <Border Style="{StaticResource BarItem}" MouseLeftButtonUp="OnStatusClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BluetoothIcon" Text="&#xE702;" Style="{StaticResource Icon}" FontSize="13.5"
                                   Margin="0,0,12,0"/>
                        <Grid x:Name="WifiPanel" Margin="0,0,12,0" VerticalAlignment="Center">
                            <!-- full-strength shape drawn faintly, with the real signal level drawn over it -->
                            <TextBlock x:Name="WifiBack" Text="&#xE701;" Style="{StaticResource Icon}" Opacity="0.3"/>
                            <TextBlock x:Name="WifiIcon" Text="&#xE701;" Style="{StaticResource Icon}"/>
                        </Grid>

                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryText" FontWeight="SemiBold" Margin="0,0,6,1"
                                       Foreground="{DynamicResource BarText}" VerticalAlignment="Center"/>
                            <!-- battery drawn like the macOS icon: an outline, a fill and a small cap -->
                            <Grid Width="25" Height="12" VerticalAlignment="Center">
                                <Border Width="22" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1.1"
                                        BorderBrush="{DynamicResource BarText}" Opacity="0.55"/>
                                <Border x:Name="BatteryFill" Width="16" HorizontalAlignment="Left" Margin="2,2,0,2"
                                        CornerRadius="1.8" Background="{DynamicResource BarText}"/>
                                <Border Width="2" Height="4.5" HorizontalAlignment="Right" Margin="0,0,1,0"
                                        CornerRadius="0,1.2,1.2,0" Background="{DynamicResource BarText}" Opacity="0.55"/>
                                <TextBlock x:Name="ChargingBolt" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="9.5" Foreground="Black" HorizontalAlignment="Left" Margin="6.5,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- notifications: opens the Windows notification centre -->
                <Border x:Name="NotificationsButton" Style="{StaticResource BarItem}"
                        MouseLeftButtonUp="OnNotificationsClick" ToolTip="Notifications">
                    <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" FontSize="14"/>
                </Border>

                <!-- Claude mascot: spins while Claude works, pulses orange when Claude is ready for you -->
                <Border x:Name="ClaudeButton" Style="{StaticResource BarItem}" Padding="6,0"
                        MouseLeftButtonUp="OnClaudeClick" ToolTip="Claude is idle">
                    <Canvas Width="20" Height="20" VerticalAlignment="Center">
                        <Path x:Name="ClaudeSpark" Fill="#D97757" Canvas.Left="10" Canvas.Top="10">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SparkScale"/>
                                    <RotateTransform x:Name="SparkSpin"/>
                                </TransformGroup>
                            </Path.RenderTransform>
                            <Path.Effect>
                                <DropShadowEffect x:Name="SparkGlow" Color="#FF8A5B" BlurRadius="9" ShadowDepth="0" Opacity="0"/>
                            </Path.Effect>
                        </Path>
                    </Canvas>
                </Border>

                <!-- far right: Glint Settings -->
                <Border Style="{StaticResource BarItem}" MouseLeftButtonUp="OnSettingsClick" ToolTip="Glint Settings">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13.5"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
