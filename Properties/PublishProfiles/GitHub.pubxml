<?xml version="1.0" encoding="utf-8"?>
<!--
  The GitHub release build: one self-contained Glint.exe that runs on any 64-bit Windows 10 (2004+) / 11 PC,
  with no .NET install needed. Build it with:
      dotnet publish -c Release -p:PublishProfile=GitHub
  The result is publish\Glint.exe; zip it for the GitHub release (see README, "Making a release").
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native parts go inside the exe too, so it really is a single file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      No compression inside the exe. Compressed, the exe is 71 MB but Glint then uses ~300 MB of RAM (everything
      is unpacked into memory) and each Claude hook run takes ~156 ms. Uncompressed it is ~170 MB but uses
      ~105 MB of RAM and hooks take ~66 ms. The release zip shrinks the download instead.
    -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
</Project>
