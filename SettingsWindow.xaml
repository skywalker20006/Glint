<Window x:Class="Glint.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glint Settings" Width="1180" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF1B1B1F" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#99FFFFFF"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22,18,22,20"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardIntro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,0,14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style x:Key="Field" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control: radio buttons drawn as joined pills, the chosen one lit. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,22">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Search: general ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Glint Search" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="The launcher for apps, files, maths, conversions and commands."
                               Style="{StaticResource CardIntro}"/>

                    <TextBlock Text="Shortcut" Style="{StaticResource Label}"/>
                    <Button x:Name="HotkeyButton" Style="{StaticResource Field}" Click="OnHotkeyClick"
                            HorizontalAlignment="Stretch" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Click, then press the keys. Needs Ctrl, Alt, Shift or Win. Fn can't be used: keyboards never report it to Windows."/>

                    <TextBlock Text="Home currency" Style="{StaticResource Label}" Margin="0,20,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CurrencyBox" Width="80" MaxLength="3" CharacterCasing="Upper"
                                 Padding="10,7" FontSize="15" FontWeight="SemiBold" Background="#14FFFFFF" Foreground="White"
                                 BorderBrush="#33FFFFFF" CaretBrush="White" LostFocus="OnCurrencyChanged"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="used for “100 usd” with no target" Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Width="190"/>
                    </StackPanel>

                    <TextBlock Text="Excluded folders" Style="{StaticResource Label}" Margin="0,20,0,2"/>
                    <TextBlock Text="Files inside these folders, and their subfolders, won't appear in search."
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border Background="#0AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <TextBlock x:Name="NoExclusions" Text="None yet" Foreground="{StaticResource Muted}"
                                       FontSize="12.5" Margin="12,9"/>
                            <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ExcludedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,3,4,3" ToolTip="{Binding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" Foreground="{StaticResource Muted}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" Click="OnRemoveExclusion" Tag="{Binding}"
                                                        ToolTip="Stop excluding this folder" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Width="26" Height="26" CornerRadius="6"
                                                                    Background="Transparent">
                                                                <TextBlock Text="&#xE711;" FontSize="10.5" Foreground="White"
                                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Button Content="Add folder…" Style="{StaticResource Field}" Click="OnAddExclusion"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0"/>

                    <CheckBox x:Name="StartupBox" Content="Start Glint when I sign in" Margin="0,20,0,0"
                              Click="OnStartupClick"/>
                </StackPanel>
            </Border>

            <!-- ============ Search: appearance ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Search appearance" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Applies the next time the launcher opens. Preview shows it now."
                               Style="{StaticResource CardIntro}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Theme" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Content="Match Windows" Style="{StaticResource Segment}"
                                             GroupName="Theme" Tag="System" Click="OnThemeClick"/>
                                <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource Segment}"
                                             GroupName="Theme" Tag="Dark" Click="OnThemeClick"/>
                                <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource Segment}"
                                             GroupName="Theme" Tag="Light" Click="OnThemeClick"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Glass" VerticalAlignment="Center"/>
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SegmentHost}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="GlassLive" Content="Live" Style="{StaticResource Segment}"
                                             GroupName="Glass" Tag="Live" Click="OnGlassClick"
                                             ToolTip="Blurs whatever is behind the panel in real time, including video."/>
                                <RadioButton x:Name="GlassSnapshot" Content="Snapshot" Style="{StaticResource Segment}"
                                             GroupName="Glass" Tag="Snapshot" Click="OnGlassClick"
                                             ToolTip="Frosts a still picture taken when the launcher opens. Blur strength is adjustable."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Accent" VerticalAlignment="Center"/>
                        <StackPanel x:Name="AccentPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" VerticalAlignment="Center"/>

                        <TextBlock x:Name="BlurLabel" Grid.Row="3" Text="Blur" VerticalAlignment="Center"/>
                        <Slider x:Name="BlurSlider" Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="BlurValue" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>

                        <TextBlock Grid.Row="4" Text="Glass tint" VerticalAlignment="Center"/>
                        <Slider x:Name="TintSlider" Grid.Row="4" Grid.Column="1" Minimum="20" Maximum="90" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="TintValue" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>

                        <TextBlock Grid.Row="5" Text="Width" VerticalAlignment="Center"/>
                        <Slider x:Name="WidthSlider" Grid.Row="5" Grid.Column="1" Minimum="560" Maximum="900" TickFrequency="20"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="WidthValue" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>

                        <TextBlock Grid.Row="6" Text="From top" VerticalAlignment="Center"/>
                        <Slider x:Name="TopSlider" Grid.Row="6" Grid.Column="1" Minimum="5" Maximum="40" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                        <TextBlock x:Name="TopValue" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Preview" Style="{StaticResource Field}" Click="OnPreviewClick" MinWidth="100"/>
                        <Button Content="Reset appearance" Style="{StaticResource Field}" Click="OnResetClick"
                                MinWidth="140" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Skyline ============ -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Skyline" Style="{StaticResource CardTitle}"/>
                        <CheckBox x:Name="TopBarBox" Content="On" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0" Click="OnTopBarClick"/>
                    </Grid>
                    <TextBlock Text="A menu bar along the top of your screen with the time, status and quick access to Glint. Windows make room for it like they do for the taskbar."
                               Style="{StaticResource CardIntro}"/>

                    <StackPanel x:Name="SkylineOptions">
                        <TextBlock Text="Material" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MatBlur" Content="Blur" Style="{StaticResource Segment}"
                                             GroupName="Material" Tag="Blur" Click="OnMaterialClick"/>
                                <RadioButton x:Name="MatAcrylic" Content="Acrylic" Style="{StaticResource Segment}"
                                             GroupName="Material" Tag="Acrylic" Click="OnMaterialClick"/>
                                <RadioButton x:Name="MatMica" Content="Mica" Style="{StaticResource Segment}"
                                             GroupName="Material" Tag="Mica" Click="OnMaterialClick"/>
                                <RadioButton x:Name="MatSolid" Content="Solid" Style="{StaticResource Segment}"
                                             GroupName="Material" Tag="Solid" Click="OnMaterialClick"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="MaterialHint" Style="{StaticResource Hint}" Height="34"/>

                        <TextBlock Text="Show" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="ShowMedia" Content="Now playing (Spotify)" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowSpeed" Content="Network speed" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowVolume" Content="Volume" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowWifi" Content="Wi-Fi" Click="OnItemClick"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ShowBluetooth" Content="Bluetooth" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowBattery" Content="Battery" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowNotifications" Content="Notifications" Click="OnItemClick"/>
                                <CheckBox x:Name="ShowClaude" Content="Claude mascot" Click="OnClaudeMascotClick"
                                          ToolTip="Spins while Claude is working and pulses orange when Claude is ready for you."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Skyline uses the same light / dark theme as Glint Search."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="4,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
            <Button Grid.Column="1" Content="Remove Glint from this PC…" Style="{StaticResource Field}" Foreground="#FFFF9A8F"
                    Click="OnRemoveGlintClick"
                    ToolTip="Turns off start-at-sign-in, removes Glint's Claude Code hooks and deletes Glint's settings, then quits."/>
        </Grid>
    </StackPanel>
</Window>
