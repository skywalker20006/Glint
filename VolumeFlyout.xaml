<local:BarFlyout x:Class="Glint.VolumeFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glint"
        Title="Glint Sound" Width="300" Height="104"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
        PreviewKeyDown="OnPreviewKeyDown">

    <local:BarFlyout.Resources>
        <SolidColorBrush x:Key="FlyText" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="FlySubtle" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="FlyTint" Color="#B31E1E22"/>
        <SolidColorBrush x:Key="FlyTrack" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="FlyFill" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="FlyHover" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="FlyLine" Color="#1FFFFFFF"/>

        <!-- Slider in the macOS Control Centre style: a thin rounded track, a filled part and a round knob. -->
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" CornerRadius="2.5" Background="{DynamicResource FlyFill}" Margin="0,0,-8,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Knob" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="18" Height="18" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Direction="270"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource FlyTrack}" Margin="2,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Knob}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:BarFlyout.Resources>

    <Grid x:Name="Root" Margin="12">
        <Border x:Name="CardBorder" CornerRadius="16" Background="{DynamicResource FlyTint}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                    <GradientStop Color="#1FFFFFFF" Offset="0.4"/>
                    <GradientStop Color="#4DFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <StackPanel Margin="16,11,16,12">
            <Grid>
                <TextBlock Text="Sound" FontWeight="SemiBold" Foreground="{DynamicResource FlyText}"/>
                <TextBlock x:Name="DeviceText" HorizontalAlignment="Right" FontSize="11.5" MaxWidth="170"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FlySubtle}"/>
            </Grid>
            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <!-- mute toggle -->
                <Border x:Name="MuteButton" Width="30" Height="30" CornerRadius="15" Cursor="Hand"
                        Background="{DynamicResource FlyHover}" MouseLeftButtonUp="OnMuteClick" ToolTip="Mute">
                    <TextBlock x:Name="MuteIcon" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" Foreground="{DynamicResource FlyText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Margin="12,0,4,0"
                        Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                <TextBlock x:Name="PercentText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FlyText}"/>
            </Grid>

            <!-- per-app volume, filled in by VolumeFlyout.Refresh -->
            <StackPanel x:Name="AppsSection" Visibility="Collapsed">
                <Border Height="1" Background="{DynamicResource FlyLine}" Margin="0,12,0,9"/>
                <TextBlock Text="Apps" FontWeight="SemiBold" Foreground="{DynamicResource FlyText}"/>
                <StackPanel x:Name="AppsPanel" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BarFlyout>
