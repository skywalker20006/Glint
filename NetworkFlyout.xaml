<local:BarFlyout x:Class="Glint.NetworkFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glint"
        Title="Glint Network" Width="330" Height="206"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5">

    <local:BarFlyout.Resources>
        <SolidColorBrush x:Key="FlyText" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="FlySubtle" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="FlyTint" Color="#B31E1E22"/>
        <SolidColorBrush x:Key="FlyHover" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="FlyLine" Color="#1FFFFFFF"/>
    </local:BarFlyout.Resources>

    <Grid Margin="12">
        <Border x:Name="CardBorder" CornerRadius="16" Background="{DynamicResource FlyTint}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                    <GradientStop Color="#1FFFFFFF" Offset="0.4"/>
                    <GradientStop Color="#4DFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <StackPanel Margin="16,11,16,12">
            <Grid>
                <TextBlock Text="Network" FontWeight="SemiBold" Foreground="{DynamicResource FlyText}"/>
                <TextBlock x:Name="ConnectionText" HorizontalAlignment="Right" FontSize="11.5" MaxWidth="190"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FlySubtle}"/>
            </Grid>

            <TextBlock Text="DATA USED SINCE YOUR PC STARTED" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,7"
                       Foreground="{DynamicResource FlySubtle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border CornerRadius="10" Background="{DynamicResource FlyHover}" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource FlySubtle}" VerticalAlignment="Center"/>
                            <TextBlock Text="Downloaded" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource FlySubtle}"/>
                        </StackPanel>
                        <TextBlock x:Name="DownText" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FlyText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource FlyHover}" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource FlySubtle}" VerticalAlignment="Center"/>
                            <TextBlock Text="Uploaded" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource FlySubtle}"/>
                        </StackPanel>
                        <TextBlock x:Name="UpText" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource FlyText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource FlyLine}" Margin="0,11,0,8"/>
            <Grid>
                <TextBlock x:Name="TotalText" FontWeight="SemiBold" Foreground="{DynamicResource FlyText}"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="SinceText" HorizontalAlignment="Right" FontSize="11.5"
                           Foreground="{DynamicResource FlySubtle}"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:BarFlyout>
